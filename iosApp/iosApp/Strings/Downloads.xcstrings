    "downloads_cancel_all": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel all downloads"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar todos os downloads"
          }
        }
      }
    },
    "downloads_cancel_all_confirm": {
