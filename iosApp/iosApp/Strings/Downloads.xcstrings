    "downloads_cancel_all_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything in the queue will be removed. Chapters already on your device are kept."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo que está na fila será removido. Os capítulos já baixados no aparelho serão mantidos."
          }
        }
      }
    },
