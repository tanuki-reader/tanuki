      }
    },
    "settings_remove_source_downloads_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frees %1$@. Left on, they keep reading offline without the source."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera %1$@. Se ficarem, continuam sendo lidos offline sem a fonte."
          }
        }
      }
    },
    "settings_remove_source_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source is removed from this device. Your library, reading progress and history are kept — install it again to start fetching new chapters."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fonte é removida deste dispositivo. Sua biblioteca, seu progresso de leitura e seu histórico são mantidos — instale-a novamente para voltar a buscar novos capítulos."
          }
        }
      }
    },
    "settings_remove_source_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove %1$@?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover %1$@?"
          }
        }
