    "settings_crash_reporting_collected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When this is on, a crash sends the error and its stack trace, your device model and OS version, and the app version. It helps fix the crashes you actually hit instead of the ones we can reproduce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, uma falha envia o erro e seu stack trace, o modelo do aparelho e a versão do sistema, e a versão do app. Isso ajuda a corrigir as falhas que você realmente encontra, e não apenas as que conseguimos reproduzir."
          }
        }
      }
    },
    "settings_crash_reporting_never": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It never sends what you read: no titles, no library, no reading history, no screenshots. This is off until you turn it on, and turning it off stops it immediately."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca envia o que você lê: nenhum título, nenhuma biblioteca, nenhum histórico de leitura, nenhuma captura de tela. Fica desativado até você ativar, e desativar interrompe o envio imediatamente."
          }
        }
      }
    },
    "settings_crash_reporting_switch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send crash reports"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar relatórios de falhas"
          }
        }
      }
    },
