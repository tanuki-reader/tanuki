    "settings_reset_identifier_done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new identifier was created. Reports sent from now on can't be linked to earlier ones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um novo identificador foi criado. Os relatórios enviados a partir de agora não podem ser ligados aos anteriores."
          }
        }
      }
    },
    "settings_reset_identifier_explain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reports carry a random identifier so repeated crashes from one device count once. It is not tied to you or your device. Resetting it means reports sent from now on can't be linked to earlier ones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os relatórios levam um identificador aleatório para que falhas repetidas de um mesmo aparelho contem uma vez só. Ele não está ligado a você nem ao seu aparelho. Ao redefini-lo, os relatórios enviados a partir de agora não podem ser ligados aos anteriores."
          }
        }
      }
    },
