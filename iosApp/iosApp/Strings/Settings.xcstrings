    "settings_delete_category_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” will be removed from all its manga. This can’t be undone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” será removida de todos os seus mangás. Isso não pode ser desfeito."
          }
        }
      }
    },
