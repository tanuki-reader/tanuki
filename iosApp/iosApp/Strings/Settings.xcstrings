    "settings_remove_source_downloads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Also delete %1$lld downloaded chapter"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Also delete %1$lld downloaded chapters"
                }
              }
            }
          }
        },
        "pt-BR": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Excluir também %1$lld capítulo baixado"
                }
              },
