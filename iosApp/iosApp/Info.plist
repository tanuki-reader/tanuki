<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>

	<!-- Background work. `fetch` lets iOS wake the app to look for new chapters; `processing` is the
	     longer-running kind the download queue continues in. Each identifier must match its constant in
	     the shared module (LIBRARY_UPDATE_TASK_ID, DOWNLOAD_TASK_ID), or registering the task throws at
	     launch and every submitted request is rejected. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>app.tanuki.library-update</string>
		<string>app.tanuki.downloads</string>
	</array>

	<!-- Launch screen: the brand mark on the app's dark canvas (the design system's `bg`, #0C0C0C),
	     so the frames before the app draws match its first frame rather than flashing
	     white. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
</dict>
</plist>