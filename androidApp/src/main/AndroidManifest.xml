<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Sources fetch manga catalogs, covers, and pages over HTTP (Ktor); the WASM guests have no
         network capability of their own, so all traffic goes through the app's one client. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Read by AndroidConnectionObserver, which watches the default network so the app can refuse a
         source request it has no connection to make instead of discovering it a timeout later. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Announcing new chapters found by the background library update, and showing the download
         queue's progress. Requested at runtime by MainActivity: this has been a runtime permission
         since API 33 and minSdk is past that, so it is never granted at install time. Both notifiers
         no-op without it — and a download run that cannot show its notification simply runs under the
         ordinary background limits instead of failing. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The download queue runs as a `dataSync` foreground service so it keeps going with the app
         closed. Both are install-time permissions; from Android 14 the *type* must be declared too,
         which is what the SystemForegroundService entry below does. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".TanukiApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tanuki">
        <activity
            android:exported="true"
            android:name=".MainActivity"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WorkManager owns this service; the app has to declare its foreground-service *type*, which
             WorkManager cannot know. Merged rather than redeclared, so the rest of the library's own
             definition (process, exported, permissions) stays exactly as WorkManager ships it. Without
             it, DownloadWorker.setForeground throws on Android 14+ and the queue silently falls back
             to the ordinary background limits. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Sentry's SDK ships a ContentProvider that starts it at process start, before the user's
             crash-reporting choice has been read. SentryCrashReporter starts it only on opt-in, so the
             auto-start is switched off; without this, turning reporting off would not stop sessions
             from being sent. -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />

        <!-- WorkManager's automatic startup is removed so TanukiApplication's Configuration.Provider
             is the configuration that takes effect. Left in, the default initializer can install a
             stock configuration first, whose default WorkerFactory cannot construct
             LibraryUpdateWorker (it takes injected dependencies) — a failure that would only show up
             at runtime, on the first scheduled update. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
