<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Sources fetch manga catalogs, covers, and pages over HTTP (Ktor); the WASM guests have no
         network capability of their own, so all traffic goes through the app's one client. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Announcing new chapters found by the background library update. Requested at runtime by
         MainActivity: this has been a runtime permission since API 33 and minSdk is past that, so it
         is never granted at install time. The notifier no-ops without it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".TanukiApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tanuki">
        <activity
            android:exported="true"
            android:name=".MainActivity"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WorkManager's automatic startup is removed so TanukiApplication's Configuration.Provider
             is the configuration that takes effect. Left in, the default initializer can install a
             stock configuration first, whose default WorkerFactory cannot construct
             LibraryUpdateWorker (it takes injected dependencies) — a failure that would only show up
             at runtime, on the first scheduled update. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
