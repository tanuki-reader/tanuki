<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Rótulos das abas da navegação inferior -->
    <string name="tab_library">Biblioteca</string>
    <string name="tab_home">Início</string>
    <string name="tab_activity">Atividade</string>
    <string name="tab_settings">Ajustes</string>
    <string name="tab_search">Buscar</string>

    <!-- Notificação de atualização da biblioteca -->
    <string name="notification_channel_updates">Atualizações da biblioteca</string>
    <string name="notification_channel_updates_description">Novos capítulos das séries que você acompanha.</string>
    <plurals name="notification_updates_title">
        <item quantity="one">%1$d título atualizado</item>
        <item quantity="other">%1$d títulos atualizados</item>
    </plurals>
    <plurals name="notification_updates_chapters">
        <item quantity="one">%1$d novo capítulo</item>
        <item quantity="other">%1$d novos capítulos</item>
    </plurals>
    <!-- Linha de uma série numa notificação com várias: "One Piece · 3 novos capítulos" -->
    <string name="notification_updates_line">%1$s · %2$s</string>
    <!-- Notificações da fila de downloads -->
    <string name="notification_channel_source_updates">Atualizações de fontes</string>
    <string name="notification_channel_source_updates_description">Novas versões das fontes que você instalou.</string>
    <plurals name="notification_source_updates_title">
        <item quantity="one">%1$d atualização de fonte</item>
        <item quantity="other">%1$d atualizações de fontes</item>
    </plurals>
    <string name="notification_channel_downloads">Baixando</string>
    <string name="notification_channel_downloads_description">Exibida enquanto capítulos são salvos neste aparelho.</string>
    <string name="notification_channel_downloads_done">Downloads concluídos</string>
    <string name="notification_channel_downloads_done_description">Avisa quando uma fila de downloads termina ou um capítulo falha.</string>
    <string name="notification_downloads_title">Baixando capítulos</string>
    <string name="notification_downloads_starting">Iniciando…</string>
    <string name="notification_downloads_chapter">Capítulo %1$s</string>
    <string name="notification_downloads_pages">%1$d de %2$d páginas</string>
    <plurals name="notification_downloads_remaining">
        <item quantity="one">mais %1$d capítulo</item>
        <item quantity="other">mais %1$d capítulos</item>
    </plurals>
    <plurals name="notification_downloads_done">
        <item quantity="one">%1$d capítulo baixado</item>
        <item quantity="other">%1$d capítulos baixados</item>
    </plurals>
    <plurals name="notification_downloads_failed">
        <item quantity="one">Não foi possível baixar %1$d capítulo</item>
        <item quantity="other">Não foi possível baixar %1$d capítulos</item>
    </plurals>


    <!-- Navegador interno mostrado quando um site precisa do usuário: verificação da Cloudflare ou login -->
    <string name="site_session_challenge_title">Verificando sua conexão</string>
    <string name="site_session_challenge_message">O %1$s está verificando se você não é um robô. Conclua a verificação abaixo e esta tela se fecha sozinha.</string>
    <string name="site_session_login_title">Entrar</string>
    <string name="site_session_login_message">Entre no %1$s para continuar. Toque em Concluir quando terminar.</string>
    <string name="site_session_done">Concluir</string>
    <string name="site_session_cancel">Cancelar</string>
    <string name="site_session_close">Fechar</string>
    <!-- Mostrado sobre o navegador enquanto a página do desafio não está visível — antes de carregar e
         no instante após ela passar, enquanto a camada se fecha -->
    <string name="site_session_connecting">Conectando a %1$s…</string>
</resources>