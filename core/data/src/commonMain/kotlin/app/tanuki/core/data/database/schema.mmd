---
title: Tanuki Schema (v7)
---
%% Source-owned rows carry two identities: the local uuid PK, and the source-native key a refresh
%% matches them back by (manga.source_manga_key, chapters.source_chapter_key). `url` is a display
%% permalink on both — sources need not publish a per-record one, so it isn't unique.
erDiagram
    sources {
        uuid id PK
        text source_id UK "source-native id, e.g. mangadex"
        text lang
        text name
        text url
        text icon_url "nullable, source icon snapshotted at install"
        int version "nullable, bundle version at install"
    }

    manga {
        uuid id PK
        uuid source FK "-> sources.id"
        text title
        text author "nullable"
        text description "nullable"
        text cover_url "nullable"
        int cover_last_modified "epoch millis"
        text source_manga_key "nullable, unique within source (source, source_manga_key)"
        text url "permalink, not the identity"
        enum reading_mode
        enum publish_status
        text filtered_scanlators "nullable, newline-joined hidden groups"
    }

    library {
        uuid id PK,FK "-> manga.id (presence = in library)"
        int date_added "epoch millis"
        enum reading_status
    }

    chapters {
        uuid id PK
        uuid manga_id FK "-> manga.id"
        real chapter_number "nullable"
        text name "nullable, source title only"
        text scanlator "nullable, translation group credited by the source (v5)"
        text source_chapter_key "nullable, unique within manga (manga_id, source_chapter_key)"
        text url "permalink, not the identity"
        int date_upload "nullable, epoch millis"
        int date_fetch "epoch millis"
    }

    reading_progress {
        uuid chapter_id PK,FK "-> chapters.id"
        bool has_bookmark
        int last_page_read
        bool already_read
    }

    history {
        uuid id PK
        uuid chapter_id FK,UK "-> chapters.id"
        uuid manga_id FK "-> manga.id"
        int read_at "epoch millis"
    }

    categories {
        uuid id PK
        text name
    }

    manga_categories {
        uuid manga_id PK,FK "-> library.id"
        uuid category_id PK,FK "-> categories.id"
    }

    sources          ||--o{ manga            : "has"
    manga            ||--o| library          : "membership (in library)"
    manga            ||--o{ chapters          : "has"
    chapters         ||--o| reading_progress  : "local-only progress"
    chapters         ||--o| history           : "read entry (chapter_id unique)"
    manga            ||--o{ history           : "read entries"
    library          ||--o{ manga_categories  : "membership"
    categories       ||--o{ manga_categories  : "membership"
