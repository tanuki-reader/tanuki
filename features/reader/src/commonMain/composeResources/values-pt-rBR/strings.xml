<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Title shown in the reader top bar when the source didn't title the chapter. %1$s is the chapter number (e.g. "5" or "4.5"). -->
    <string name="reader_chapter_number">Capítulo %1$s</string>
    <!-- Bottom-bar page position. %1$d is the current page, %2$d the total (e.g. "3 / 20"). -->
    <string name="reader_page_indicator">%1$d / %2$d</string>
    <string name="reader_error_message">Não foi possível carregar este capítulo</string>
    <string name="reader_retry">Tentar novamente</string>
    <string name="reader_no_pages">Este capítulo não tem páginas</string>
    <!-- Chapter transition slide: overline above the chapter the reader just finished. -->
    <string name="reader_transition_finished">Concluído</string>
    <!-- Chapter transition slide: overline above the chapter coming up. -->
    <string name="reader_transition_up_next">A seguir</string>
    <!-- Chapter transition slide: hint that swiping continues into the next chapter. -->
    <string name="reader_transition_swipe_hint">Deslize para continuar</string>
    <!-- Terminal slide after the last page of the last chapter. -->
    <string name="reader_end_title">Não há mais capítulos</string>
    <!-- Terminal slide subtitle: reassures the reader they've read everything available. -->
    <string name="reader_end_subtitle">Você está em dia</string>
</resources>