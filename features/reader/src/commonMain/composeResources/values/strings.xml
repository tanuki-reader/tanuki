<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Title shown in the reader top bar when the source didn't title the chapter. %1$s is the chapter number (e.g. "5" or "4.5"). -->
    <string name="reader_chapter_number">Chapter %1$s</string>
    <!-- Bottom-bar page position. %1$d is the current page, %2$d the total (e.g. "3 / 20"). -->
    <string name="reader_page_indicator">%1$d / %2$d</string>
    <string name="reader_error_message">Couldn't load this chapter</string>
    <string name="reader_retry">Retry</string>
    <string name="reader_no_pages">This chapter has no pages</string>
    <!-- Chapter transition slide: overline above the chapter the reader just finished. -->
    <string name="reader_transition_finished">Finished</string>
    <!-- Chapter transition slide: overline above the chapter coming up. -->
    <string name="reader_transition_up_next">Up next</string>
    <!-- Chapter transition slide: hint that swiping continues into the next chapter. -->
    <string name="reader_transition_swipe_hint">Swipe to continue</string>
    <!-- Terminal slide after the last page of the last chapter. -->
    <string name="reader_end_title">No more chapters</string>
    <!-- Terminal slide subtitle: reassures the reader they've read everything available. -->
    <string name="reader_end_subtitle">You're all caught up</string>
    <!-- Reader chrome -->
    <string name="reader_back">Back</string>
    <string name="reader_bookmark_add">Bookmark this page</string>
    <string name="reader_bookmark_remove">Remove bookmark</string>
    <string name="reader_more">More options</string>
    <string name="reader_open_in_browser">Open in browser</string>
    <string name="reader_previous_chapter">Previous chapter</string>
    <string name="reader_next_chapter">Next chapter</string>
    <string name="reader_chapters">Chapters</string>
    <string name="reader_settings">Reader settings</string>
    <!-- Chapters sheet -->
    <string name="reader_tab_chapters">Chapters</string>
    <string name="reader_tab_bookmarks">Bookmarks</string>
    <string name="reader_bookmarks_empty">No bookmarks yet. Use the bookmark at the top of a page to keep your place.</string>
